<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Client Interaction & Quote Tracker</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    body { font-family: 'Inter', sans-serif; }
    /* Custom scrollbar styling */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

  <!-- Header -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
    <div class="max-w-full px-4 sm:px-6 lg:px-8 py-2 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
      <div class="flex items-center space-x-3">
        <div class="p-1.5 bg-indigo-600 text-white rounded-lg shadow-sm">
          <i class="fa-solid fa-clock-rotate-left text-base"></i>
        </div>
        <div>
          <h1 class="text-base font-bold text-slate-900 leading-tight">Interaction Tracker</h1>
          <p class="text-[11px] text-slate-500">Monitor response times, quote statuses, and last touches</p>
        </div>
      </div>
      
      <div class="flex items-center space-x-3 w-full sm:w-auto">
        <button id="quickAddBtn" onclick="openModal()" class="flex-1 sm:flex-none inline-flex items-center justify-center space-x-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-3 py-1.5 rounded-lg shadow-sm transition-all text-xs">
          <i class="fa-solid fa-plus"></i>
          <span>New Interaction / Request</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content Area -->
  <main class="flex-1 max-w-full w-full px-4 sm:px-6 lg:px-8 py-2">

    <!-- Metrics Bar -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-2 mb-2">
      <div class="bg-white p-2 rounded-xl border border-slate-200 shadow-sm flex items-center space-x-2.5">
        <div class="p-2 bg-amber-50 text-amber-600 rounded-lg">
          <i class="fa-solid fa-hourglass-half text-sm"></i>
        </div>
        <div>
          <p class="text-[10px] font-medium text-slate-500 uppercase tracking-wider">Pending Action</p>
          <p id="statPending" class="text-lg font-bold text-slate-800 leading-none mt-0.5">0</p>
        </div>
      </div>

      <div class="bg-white p-2 rounded-xl border border-slate-200 shadow-sm flex items-center space-x-2.5">
        <div class="p-2 bg-rose-50 text-rose-600 rounded-lg">
          <i class="fa-solid fa-triangle-exclamation text-sm"></i>
        </div>
        <div>
          <p class="text-[10px] font-medium text-slate-500 uppercase tracking-wider">Needs Touch (>24h)</p>
          <p id="statNeedsTouch" class="text-lg font-bold text-slate-800 leading-none mt-0.5">0</p>
        </div>
      </div>

      <div class="bg-white p-2 rounded-xl border border-slate-200 shadow-sm flex items-center space-x-2.5">
        <div class="p-2 bg-blue-50 text-blue-600 rounded-lg">
          <i class="fa-solid fa-comments text-sm"></i>
        </div>
        <div>
          <p class="text-[10px] font-medium text-slate-500 uppercase tracking-wider">Active Contact</p>
          <p id="statActive" class="text-lg font-bold text-slate-800 leading-none mt-0.5">0</p>
        </div>
      </div>

      <div class="bg-white p-2 rounded-xl border border-slate-200 shadow-sm flex items-center space-x-2.5">
        <div class="p-2 bg-emerald-50 text-emerald-600 rounded-lg">
          <i class="fa-solid fa-circle-check text-sm"></i>
        </div>
        <div>
          <p class="text-[10px] font-medium text-slate-500 uppercase tracking-wider">Completed</p>
          <p id="statCompleted" class="text-lg font-bold text-slate-800 leading-none mt-0.5">0</p>
        </div>
      </div>
    </div>

    <!-- Filters and Search Controls -->
    <div class="bg-white p-2 rounded-xl border border-slate-200 shadow-sm mb-2 flex flex-col md:flex-row gap-2 items-center justify-between">
      <div class="relative w-full md:w-80">
        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
        <input type="text" id="searchInput" placeholder="Search client, affiliate, note..." oninput="renderTable()" class="w-full pl-8 pr-3 py-1 border border-slate-200 rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
      </div>

      <div class="flex flex-wrap items-center gap-2 w-full md:w-auto">
        <!-- Filter Tabs -->
        <div class="bg-slate-100 p-0.5 rounded-lg flex space-x-1 text-xs font-medium w-full sm:w-auto overflow-x-auto">
          <button onclick="setFilter('all')" id="filter-all" class="filter-tab px-2.5 py-0.5 rounded-md transition-all bg-white text-slate-800 shadow-sm">All</button>
          <button onclick="setFilter('pending')" id="filter-pending" class="filter-tab px-2.5 py-0.5 rounded-md text-slate-600 hover:text-slate-900 transition-all">Pending</button>
          <button onclick="setFilter('urgent')" id="filter-urgent" class="filter-tab px-2.5 py-0.5 rounded-md text-slate-600 hover:text-slate-900 transition-all">Urgent (>24h)</button>
          <button onclick="setFilter('completed')" id="filter-completed" class="filter-tab px-2.5 py-0.5 rounded-md text-slate-600 hover:text-slate-900 transition-all">Completed</button>
        </div>

        <!-- Sort Select -->
        <select id="sortBy" onchange="renderTable()" class="border border-slate-200 rounded-lg px-2.5 py-1 text-xs font-medium text-slate-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white">
          <option value="longest">Longest Idle First</option>
          <option value="recent">Most Recently Updated</option>
          <option value="client">Client Name</option>
        </select>
      </div>
    </div>

    <!-- Table Container -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm">
      <div class="overflow-x-auto overflow-y-visible pb-16 min-h-[300px]">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
              <th class="py-2 px-3 w-1/6">Created By</th>
              <th class="py-2 px-3 w-1/5">Client</th>
              <th class="py-2 px-3 w-1/5">Affiliate</th>
              <th class="py-2 px-3 w-1/3">Last Interacted</th>
              <th class="py-2 px-3 w-1/6">Status</th>
              <th class="py-2 px-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="tableBody" class="divide-y divide-slate-100 text-xs">
            <!-- Dynamic Table Rows Inserted Here -->
          </tbody>
        </table>
      </div>

      <!-- Empty State -->
      <div id="emptyState" class="hidden text-center py-6 bg-white">
        <div class="w-10 h-10 bg-indigo-50 text-indigo-500 rounded-full flex items-center justify-center mx-auto mb-2 text-lg">
          <i class="fa-solid fa-inbox"></i>
        </div>
        <h3 class="text-xs font-semibold text-slate-800">No interactions found</h3>
        <p class="text-[11px] text-slate-500 max-w-sm mx-auto mt-0.5 mb-2">No records match your selected filters or search query.</p>
        <button onclick="openModal()" class="inline-flex items-center space-x-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-2.5 py-1 rounded-lg text-xs">
          <i class="fa-solid fa-plus"></i>
          <span>Add First Interaction</span>
        </button>
      </div>
    </div>

  </main>

  <!-- Modal Form (Add / Edit / Update) -->
  <div id="itemModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-2xl shadow-xl border border-slate-100 max-w-md w-full overflow-hidden transform transition-all">
      <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
        <h3 id="modalTitle" class="font-semibold text-slate-800 text-base">Record New Interaction</h3>
        <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>
      
      <form id="trackerForm" onsubmit="handleFormSubmit(event)" class="p-6 space-y-4">
        <input type="hidden" id="editId" value="" />

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">Created By (Your Name) *</label>
          <input type="text" id="createdBy" required placeholder="e.g. Sarah, Alex" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">Client Name *</label>
          <input type="text" id="clientName" required placeholder="e.g. Airene, John Smith" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">Affiliate / Partner Name</label>
          <input type="text" id="affiliateName" placeholder="e.g. Nexus Network, Direct, Affiliate-A" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">Channel / Medium</label>
            <select id="channel" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white">
              <option value="Email">Email</option>
              <option value="Affiliate Quote Request">Affiliate Quote Request</option>
              <option value="Client Quote Request">Client Quote Request</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">Status</label>
            <select id="status" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white">
              <option value="Pending">Pending</option>
              <option value="Waiting">Waiting</option>
              <option value="In Progress">In Progress</option>
              <option value="Completed">Completed</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">Last Interaction Note</label>
          <input type="text" id="actionNote" placeholder="e.g. Emailed revised quote to affiliate" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">Timestamp of Interaction</label>
          <input type="datetime-local" id="interactionTime" required class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <p class="text-[11px] text-slate-400 mt-1">Set back to when the interaction actually occurred.</p>
        </div>

        <div class="pt-3 border-t border-slate-100 flex justify-end space-x-2">
          <button type="button" onclick="closeModal()" class="px-4 py-2 rounded-lg text-xs font-medium text-slate-600 hover:bg-slate-100 transition-all">Cancel</button>
          <button type="submit" class="px-4 py-2 rounded-lg text-xs font-medium bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm transition-all">Save Record</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Custom Notification Banner Container -->
  <div id="toastContainer" class="fixed bottom-4 right-4 z-50 flex flex-col space-y-2 pointer-events-none"></div>

  <!-- Firebase & Application JavaScript -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
    import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
    import { getFirestore, collection, doc, setDoc, deleteDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

    // Firebase Setup with local state fallback
    const appId = typeof __app_id !== 'undefined' ? __app_id : 'interaction-tracker';
    const firebaseConfig = typeof __firebase_config !== 'undefined' 
      ? JSON.parse(__firebase_config) 
      : { apiKey: "demo-key", authDomain: "demo.firebaseapp.com", projectId: "demo-project" };

    let app, db, auth, trackerCollectionRef;
    try {
      app = initializeApp(firebaseConfig);
      db = getFirestore(app);
      auth = getAuth(app);
      trackerCollectionRef = collection(db, 'artifacts', appId, 'public', 'data', 'interactions');
    } catch (e) {
      console.warn("Firebase initialization skipped/failed, using local fallback mode.", e);
    }

    // Global state
    let items = [];
    let currentFilter = 'all';
    let currentUser = null;

    // Load initial data from localStorage if available, or use defaults
    function loadLocalData() {
      const saved = localStorage.getItem('interaction_tracker_data');
      if (saved) {
        try { return JSON.parse(saved); } catch (e) {}
      }
      return [
        {
          id: '1',
          createdBy: 'Sarah',
          clientName: 'Airene',
          affiliateName: 'Nexus Network',
          channel: 'Affiliate Quote Request',
          status: 'Pending',
          actionNote: 'Awaiting updated quote parameters from affiliate team',
          lastInteractionTime: new Date(Date.now() - 28 * 3600 * 1000).toISOString(),
          completedTime: null
        },
        {
          id: '2',
          createdBy: 'Alex',
          clientName: 'John Smith',
          affiliateName: 'Direct',
          channel: 'Email',
          status: 'In Progress',
          actionNote: 'Sent revised agreement draft to client',
          lastInteractionTime: new Date(Date.now() - 3 * 3600 * 1000).toISOString(),
          completedTime: null
        }
      ];
    }

    function saveLocalData() {
      try {
        localStorage.setItem('interaction_tracker_data', JSON.stringify(items));
      } catch (e) {
        console.warn("Unable to write to local storage", e);
      }
    }

    // Authenticate and set up live updates with timeout safeguard
    async function initFirebase() {
      items = loadLocalData();
      renderTable();

      if (!auth) return;

      try {
        const authPromise = typeof __initial_auth_token !== 'undefined' && __initial_auth_token
          ? signInWithCustomToken(auth, __initial_auth_token)
          : signInAnonymously(auth);

        // Timeout auth after 2 seconds so UI never blocks
        await Promise.race([
          authPromise,
          new Promise((_, reject) => setTimeout(() => reject('Auth Timeout'), 2000))
        ]);
      } catch (err) {
        console.warn("Auth initialization skipped or timed out; using local storage mode.", err);
      }

      if (auth && trackerCollectionRef) {
        onAuthStateChanged(auth, (user) => {
          if (user) {
            currentUser = user;
            subscribeToLiveUpdates();
          }
        });
      }
    }

    // Real-time Firestore sync
    function subscribeToLiveUpdates() {
      if (!trackerCollectionRef) return;
      onSnapshot(trackerCollectionRef, (snapshot) => {
        const loadedItems = [];
        snapshot.forEach((docSnap) => {
          loadedItems.push({ id: docSnap.id, ...docSnap.data() });
        });
        
        if (loadedItems.length > 0) {
          items = loadedItems;
          saveLocalData();
          renderTable();
        }
      }, (error) => {
        console.warn("Firestore sync unavailable, staying in local mode:", error);
      });
    }

    // Save record with guaranteed completion (never hangs form submit)
    async function saveRecordToCloud(itemData) {
      saveLocalData();
      if (!auth || !auth.currentUser || !trackerCollectionRef) return;
      
      try {
        const docRef = doc(trackerCollectionRef, itemData.id);
        const setPromise = setDoc(docRef, itemData, { merge: true });
        // Enforce 1.5s limit on cloud write so UI remains responsive
        await Promise.race([
          setPromise,
          new Promise((_, reject) => setTimeout(() => reject('Write Timeout'), 1500))
        ]);
      } catch (err) {
        console.warn("Cloud sync skipped, item saved locally:", err);
      }
    }

    // Delete record
    async function deleteRecordFromCloud(id) {
      saveLocalData();
      if (!auth || !auth.currentUser || !trackerCollectionRef) return;
      try {
        const docRef = doc(trackerCollectionRef, id);
        await deleteDoc(docRef);
      } catch (err) {
        console.warn("Cloud delete skipped, removed locally:", err);
      }
    }

    // Helper functions for status styling and date formatting
    function getStatusBadge(status) {
      switch(status) {
        case 'Pending': return 'bg-amber-100 text-amber-800 border-amber-300';
        case 'Waiting': return 'bg-blue-100 text-blue-800 border-blue-300';
        case 'In Progress': return 'bg-indigo-100 text-indigo-800 border-indigo-300';
        case 'Completed': return 'bg-emerald-100 text-emerald-800 border-emerald-300';
        default: return 'bg-slate-100 text-slate-800 border-slate-300';
      }
    }

    function getRelativeTimeString(dateIsoString) {
      if (!dateIsoString) return 'N/A';
      const now = new Date();
      const past = new Date(dateIsoString);
      const diffMs = now - past;
      const diffMins = Math.floor(diffMs / (1000 * 60));
      const diffHours = Math.floor(diffMs / (1000 * 3600));
      const diffDays = Math.floor(diffMs / (1000 * 3600 * 24));

      if (diffMins < 1) return 'Just now';
      if (diffMins < 60) return `${diffMins}m ago`;
      if (diffHours < 24) return `${diffHours}h ago`;
      return `${diffDays}d ago`;
    }

    function formatDateTime(dateIsoString) {
      if (!dateIsoString) return '';
      const d = new Date(dateIsoString);
      return d.toLocaleDateString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    }

    // Get color theme according to hours elapsed for last interaction badge
    function getAgeBadgeClass(dateIsoString, isCompleted) {
      if (isCompleted) return 'text-slate-500 bg-slate-100 border-slate-200';
      const hoursAgo = (new Date() - new Date(dateIsoString)) / (1000 * 3600);
      if (hoursAgo >= 24) return 'bg-rose-100 text-rose-800 border-rose-200 font-semibold';
      if (hoursAgo >= 8) return 'bg-amber-50 text-amber-800 border-amber-200';
      return 'bg-indigo-50 text-indigo-700 border-indigo-100';
    }

    // Render Table Rows
    function renderTable() {
      const tbody = document.getElementById('tableBody');
      const emptyState = document.getElementById('emptyState');
      const searchVal = (document.getElementById('searchInput')?.value || '').toLowerCase();
      const sortBy = document.getElementById('sortBy')?.value || 'longest';

      let filtered = items.filter(item => {
        if (currentFilter === 'pending' && item.status === 'Completed') return false;
        if (currentFilter === 'completed' && item.status !== 'Completed') return false;
        if (currentFilter === 'urgent') {
          const hoursAgo = (new Date() - new Date(item.lastInteractionTime)) / (1000 * 3600);
          if (item.status === 'Completed' || hoursAgo < 24) return false;
        }

        const matchCreator = (item.createdBy || '').toLowerCase().includes(searchVal);
        const matchClient = (item.clientName || '').toLowerCase().includes(searchVal);
        const matchAffiliate = (item.affiliateName || '').toLowerCase().includes(searchVal);
        const matchChannel = (item.channel || '').toLowerCase().includes(searchVal);
        const matchNote = (item.actionNote || '').toLowerCase().includes(searchVal);
        return matchCreator || matchClient || matchAffiliate || matchChannel || matchNote;
      });

      filtered.sort((a, b) => {
        if (sortBy === 'longest') {
          return new Date(a.lastInteractionTime) - new Date(b.lastInteractionTime);
        } else if (sortBy === 'recent') {
          return new Date(b.lastInteractionTime) - new Date(a.lastInteractionTime);
        } else if (sortBy === 'client') {
          return (a.clientName || '').localeCompare(b.clientName || '');
        }
      });

      if (filtered.length === 0) {
        tbody.innerHTML = '';
        emptyState.classList.remove('hidden');
        return;
      }

      emptyState.classList.add('hidden');
      tbody.innerHTML = filtered.map(item => {
        const isCompleted = item.status === 'Completed';
        const relativeTime = getRelativeTimeString(item.lastInteractionTime);
        const ageBadgeClass = getAgeBadgeClass(item.lastInteractionTime, isCompleted);
        const statusBadgeClass = getStatusBadge(item.status);

        return `
          <tr class="hover:bg-slate-50/80 transition-colors">
            <td class="py-2 px-3 align-middle">
              <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 font-semibold text-xs border border-slate-200">
                <i class="fa-regular fa-user text-[10px] text-slate-400"></i>
                <span>${escapeHtml(item.createdBy || 'Unknown')}</span>
              </div>
            </td>

            <td class="py-2 px-3 align-middle">
              <div class="font-semibold text-slate-900">${escapeHtml(item.clientName || 'N/A')}</div>
              <div class="text-[11px] text-slate-500 flex items-center gap-1 mt-0.5">
                <span class="inline-block px-1.5 py-0.5 bg-slate-100 text-slate-600 rounded text-[10px]">${escapeHtml(item.channel || 'General')}</span>
              </div>
            </td>

            <td class="py-2 px-3 align-middle text-slate-700 font-medium">
              ${escapeHtml(item.affiliateName || '-')}
            </td>

            <td class="py-2 px-3 align-middle">
              <div class="flex items-center space-x-2">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] border ${ageBadgeClass}">
                  <i class="fa-regular fa-clock mr-1 text-[9px]"></i>
                  ${relativeTime}
                </span>
                <span class="text-[11px] text-slate-400">
                  ${formatDateTime(item.lastInteractionTime)}
                </span>
              </div>
              <p class="text-[11px] text-slate-600 mt-0.5 max-w-lg truncate" title="${escapeHtml(item.actionNote || '')}">
                ${escapeHtml(item.actionNote || 'No note added')}
              </p>
            </td>

            <td class="py-2 px-3 align-middle relative">
              <div class="relative inline-block text-left">
                <button onclick="window.toggleStatusDropdown('${item.id}', event)" class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-xs font-semibold border ${statusBadgeClass} hover:opacity-80 transition-all cursor-pointer">
                  <span>${escapeHtml(item.status)}</span>
                  <i class="fa-solid fa-chevron-down text-[9px] opacity-60"></i>
                </button>

                <div id="statusMenu-${item.id}" class="hidden absolute left-0 top-full mt-1 w-36 bg-white border border-slate-200 rounded-lg shadow-xl z-50 py-1 text-xs">
                  <button onclick="window.changeStatus('${item.id}', 'Pending', event)" class="w-full text-left px-3 py-1.5 hover:bg-amber-50 text-amber-800 flex items-center space-x-2 font-medium">
                    <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                    <span>Pending</span>
                  </button>
                  <button onclick="window.changeStatus('${item.id}', 'Waiting', event)" class="w-full text-left px-3 py-1.5 hover:bg-blue-50 text-blue-800 flex items-center space-x-2 font-medium">
                    <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                    <span>Waiting</span>
                  </button>
                  <button onclick="window.changeStatus('${item.id}', 'In Progress', event)" class="w-full text-left px-3 py-1.5 hover:bg-indigo-50 text-indigo-800 flex items-center space-x-2 font-medium">
                    <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
                    <span>In Progress</span>
                  </button>
                  <div class="border-t border-slate-100 my-0.5"></div>
                  <button onclick="window.changeStatus('${item.id}', 'Completed', event)" class="w-full text-left px-3 py-1.5 hover:bg-emerald-50 text-emerald-800 flex items-center space-x-2 font-medium">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    <span>Completed</span>
                  </button>
                </div>
              </div>

              ${isCompleted && item.completedTime ? `
                <div class="text-[10px] text-emerald-700 mt-0.5 flex items-center gap-1">
                  <i class="fa-solid fa-check text-[9px]"></i>
                  <span>${formatDateTime(item.completedTime)}</span>
                </div>
              ` : ''}
            </td>

            <td class="py-2 px-3 align-middle text-right">
              <div class="flex items-center justify-end space-x-1">
                ${!isCompleted ? `
                  <button onclick="window.markAsCompleted('${item.id}')" title="Mark as Completed" class="px-2 py-0.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded text-xs font-medium transition-colors">
                    Done
                  </button>
                ` : `
                  <button onclick="window.reopenItem('${item.id}')" title="Re-open" class="px-2 py-0.5 bg-amber-100 text-amber-800 hover:bg-amber-200 rounded text-xs font-medium transition-colors">
                    Re-open
                  </button>
                `}

                <button onclick="window.editItem('${item.id}')" title="Edit" class="p-1 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded">
                  <i class="fa-solid fa-pen text-xs"></i>
                </button>
                <button onclick="window.deleteItem('${item.id}')" title="Delete" class="p-1 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded">
                  <i class="fa-solid fa-trash-can text-xs"></i>
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');

      updateStats();
    }

    // Toggle status inline dropdown
    window.toggleStatusDropdown = function(id, e) {
      if (e) e.stopPropagation();
      document.querySelectorAll('[id^="statusMenu-"]').forEach(el => {
        if (el.id !== `statusMenu-${id}`) el.classList.add('hidden');
      });

      const menu = document.getElementById(`statusMenu-${id}`);
      if (menu) {
        menu.classList.toggle('hidden');
      }
    };

    // Change status directly from status badge
    window.changeStatus = async function(id, newStatus, e) {
      if (e) e.stopPropagation();
      const item = items.find(i => i.id === id);
      if (item) {
        const updatedItem = {
          ...item,
          status: newStatus,
          completedTime: newStatus === 'Completed' ? (item.completedTime || new Date().toISOString()) : null
        };
        const index = items.findIndex(i => i.id === id);
        if (index !== -1) items[index] = updatedItem;
        renderTable();
        showToast(`Status updated to "${newStatus}"`);
        await saveRecordToCloud(updatedItem);
      }
    };

    // Close status menus when clicking anywhere outside
    document.addEventListener('click', () => {
      document.querySelectorAll('[id^="statusMenu-"]').forEach(el => el.classList.add('hidden'));
    });

    // Helper to update top metrics cards
    function updateStats() {
      const pending = items.filter(i => i.status !== 'Completed').length;
      const completed = items.filter(i => i.status === 'Completed').length;
      const needsTouch = items.filter(i => {
        if (i.status === 'Completed') return false;
        const hoursAgo = (new Date() - new Date(i.lastInteractionTime)) / (1000 * 3600);
        return hoursAgo >= 24;
      }).length;

      document.getElementById('statPending').innerText = pending;
      document.getElementById('statCompleted').innerText = completed;
      document.getElementById('statNeedsTouch').innerText = needsTouch;
      document.getElementById('statActive').innerText = items.length;
    }

    // Set active filter
    window.setFilter = function(filterName) {
      currentFilter = filterName;
      document.querySelectorAll('.filter-tab').forEach(tab => {
        tab.classList.remove('bg-white', 'text-slate-800', 'shadow-sm');
        tab.classList.add('text-slate-600');
      });

      const activeBtn = document.getElementById(`filter-${filterName}`);
      if (activeBtn) {
        activeBtn.classList.add('bg-white', 'text-slate-800', 'shadow-sm');
        activeBtn.classList.remove('text-slate-600');
      }

      renderTable();
    };

    // Handle Form submission instantly
    window.handleFormSubmit = async function(e) {
      e.preventDefault();
      const id = document.getElementById('editId').value;
      const createdBy = document.getElementById('createdBy').value.trim();
      const clientName = document.getElementById('clientName').value.trim();
      const affiliateName = document.getElementById('affiliateName').value.trim();
      const channel = document.getElementById('channel').value;
      const status = document.getElementById('status').value;
      const actionNote = document.getElementById('actionNote').value.trim();
      const interactionTimeInput = document.getElementById('interactionTime').value;

      const interactionIso = new Date(interactionTimeInput).toISOString();

      let targetItem;

      if (id) {
        const existingIndex = items.findIndex(item => item.id === id);
        const existingItem = items[existingIndex] || {};
        targetItem = {
          ...existingItem,
          id,
          createdBy,
          clientName,
          affiliateName,
          channel,
          status,
          actionNote,
          lastInteractionTime: interactionIso,
          completedTime: status === 'Completed' ? (existingItem?.completedTime || new Date().toISOString()) : null
        };
        
        if (existingIndex !== -1) {
          items[existingIndex] = targetItem;
        }
        showToast("Record updated");
      } else {
        targetItem = {
          id: Date.now().toString(),
          createdBy,
          clientName,
          affiliateName,
          channel,
          status,
          actionNote,
          lastInteractionTime: interactionIso,
          completedTime: status === 'Completed' ? new Date().toISOString() : null
        };

        items.unshift(targetItem);
        showToast("New interaction logged");
      }

      // Close modal and refresh UI instantly
      window.closeModal();
      renderTable();

      // Non-blocking async background cloud sync
      saveRecordToCloud(targetItem);
    };

    // Mark completed
    window.markAsCompleted = async function(id) {
      const itemIndex = items.findIndex(i => i.id === id);
      if (itemIndex !== -1) {
        const now = new Date().toISOString();
        const updatedItem = {
          ...items[itemIndex],
          status: 'Completed',
          completedTime: now,
          lastInteractionTime: now
        };
        items[itemIndex] = updatedItem;
        renderTable();
        showToast(`Marked ${updatedItem.clientName} as completed`);
        await saveRecordToCloud(updatedItem);
      }
    };

    // Reopen completed item
    window.reopenItem = async function(id) {
      const itemIndex = items.findIndex(i => i.id === id);
      if (itemIndex !== -1) {
        const updatedItem = {
          ...items[itemIndex],
          status: 'Pending',
          completedTime: null,
          lastInteractionTime: new Date().toISOString()
        };
        items[itemIndex] = updatedItem;
        renderTable();
        showToast(`Reopened tracker for ${updatedItem.clientName}`);
        await saveRecordToCloud(updatedItem);
      }
    };

    // Edit item
    window.editItem = function(id) {
      const item = items.find(i => i.id === id);
      if (!item) return;

      document.getElementById('editId').value = item.id;
      document.getElementById('createdBy').value = item.createdBy || '';
      document.getElementById('clientName').value = item.clientName || '';
      document.getElementById('affiliateName').value = item.affiliateName || '';
      document.getElementById('channel').value = item.channel || 'Email';
      document.getElementById('status').value = item.status || 'Pending';
      document.getElementById('actionNote').value = item.actionNote || '';
      
      const date = new Date(item.lastInteractionTime);
      date.setMinutes(date.getMinutes() - date.getTimezoneOffset());
      document.getElementById('interactionTime').value = date.toISOString().slice(0, 16);

      document.getElementById('modalTitle').innerText = 'Edit Record';
      document.getElementById('itemModal').classList.remove('hidden');
    };

    // Delete item
    window.deleteItem = async function(id) {
      const itemToDelete = items.find(i => i.id === id);
      const clientName = itemToDelete ? itemToDelete.clientName : 'Record';
      
      items = items.filter(i => i.id !== id);
      renderTable();
      showToast(`Deleted ${clientName}`);
      await deleteRecordFromCloud(id);
    };

    // Modal controls
    window.openModal = function() {
      document.getElementById('trackerForm').reset();
      document.getElementById('editId').value = '';
      
      const now = new Date();
      now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
      document.getElementById('interactionTime').value = now.toISOString().slice(0, 16);

      document.getElementById('modalTitle').innerText = 'Record New Interaction';
      document.getElementById('itemModal').classList.remove('hidden');
    };

    window.closeModal = function() {
      document.getElementById('itemModal').classList.add('hidden');
    };

    // Make renderTable globally accessible
    window.renderTable = renderTable;

    function escapeHtml(str) {
      if (!str) return '';
      return str.replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
    }

    function showToast(message) {
      const container = document.getElementById('toastContainer');
      if (!container) return;
      const toast = document.createElement('div');
      toast.className = 'bg-slate-900 text-white px-4 py-2.5 rounded-lg shadow-lg text-xs font-medium flex items-center space-x-2 pointer-events-auto transform transition-all duration-300 translate-y-2 opacity-0';
      toast.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-400"></i><span>${escapeHtml(message)}</span>`;
      
      container.appendChild(toast);
      
      setTimeout(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      }, 10);

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }

    // Initialize application
    window.onload = function() {
      initFirebase();
    };
  </script>
</body>
</html>
